# CargoTracker Environment Variables Template

# 1. Supabase Database REST API Settings
VITE_SUPABASE_URL=https://bpvbnzbabrzueoxabqel.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# 2. Leaflet Map Tile API Key
VITE_MAP_API_KEY=your_map_api_key_here

# 3. Marine Port Congestion & Vessel Tracking Key
VITE_MARITIME_PORT_KEY=your_maritime_key_here

# 4. Open-Meteo Free Forecast API Endpoint (No API Key Required)
VITE_OPENMETEO_API_URL=https://api.open-meteo.com/v1/forecast
